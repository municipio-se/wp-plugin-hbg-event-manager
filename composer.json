{
    "name": "municipio/wp-plugin-hbg-event-manager",
    "description": "Creates a api that may be used to manage events",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Kristoffer Svanmark",
            "email": "kristoffer.svanmark@lexiconitkonsult.se"
        },
        {
            "name": "Sebastian Thulin",
            "email": "sebastian.thulin@helsingborg.se"
        },
        {
            "name": "Jonatan Hanson",
            "email": "jonatan.hanson@hiq.se"
        },
        {
            "name": "Tommy Moberg",
            "email": "tommy.moberg@hiq.se"
        },
        {
            "name": "Whitespace",
            "email": "code@whitespace.se"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "installer-name": "api-event-manager",
        "installer-paths": {
            "vendor/{$vendor}/{$name}/": [
                "vendor:wpackagist-plugin",
                "type:wordpress-plugin",
                "type:wordpress-muplugin"
            ]
        }
    },
    "require": {
        "composer/installers": "~2.2"
    },
    "require-dev": {
        "10up/wp_mock": "dev-trunk#1.0.1",
        "giggsey/libphonenumber-for-php": "^7.4",
        "php-mock/php-mock-mockery": "^1.4"
    },
    "suggest": {
        "giggsey/libphonenumber-for-php": "Required by Helsingborg’s Event Manager plugin"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
